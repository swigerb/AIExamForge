{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-azure-sql-server.database.windows.net;Database=AIExamForge;Authentication=Active Directory Managed Identity;TrustServerCertificate=True;Min Pool Size=5;Max Pool Size=100;Connection Timeout=30;Connection Lifetime=0;MultipleActiveResultSets=true;Encrypt=True;"
  },
  "DatabaseSettings": {
    "CommandTimeout": 30,
    "MinPoolSize": 5,
    "MaxPoolSize": 100,
    "ConnectionLifetime": 300,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "your-tenant.onmicrosoft.com",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "Audience": "api://your-client-id"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "gpt-4o",
    "ApiKey": ""
  },
  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-key;EndpointSuffix=core.windows.net",
    "ContainerName": "aiexamforge"
  },
  "KeyVault": {
    "VaultUri": "https://your-keyvault.vault.azure.net/"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend-domain.com"
    ]
  }
}
