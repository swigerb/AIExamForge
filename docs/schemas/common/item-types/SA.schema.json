{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/SA.schema.json",
  "title": "SA",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "expectedAnswerVariants", "maxLines", "maxMultiLineLines"],
  "properties": {
    "prompt": { "type": "string", "minLength": 10 },
    "starterCode": { "type": "string" },
    "maxLines": { "type": "integer", "maximum": 10, "default": 10 },
    "maxSingleLinePieces": { "type": "integer", "maximum": 5, "default": 5 },
    "maxMultiLineLines": { "type": "integer", "maximum": 4, "default": 4 },
    "expectedAnswerVariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "syntaxCheckEnabled": { "type": "boolean", "default": true }
  }
}
