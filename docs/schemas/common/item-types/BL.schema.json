{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/BL.schema.json",
  "title": "BL",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps", "requiredMoveCount", "validOrders"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 2 }
    },
    "requiredMoveCount": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5,
      "description": "Must be stated in the instruction statement."
    },
    "validOrders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "items": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "description": "Up to two valid permutations using the same step options."
    },
    "distractorSteps": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
