{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/LABS.schema.json",
  "title": "Labs",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "successCriteria"],
  "properties": {
    "scenario": { "type": "string", "minLength": 20 },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    }
  }
}
