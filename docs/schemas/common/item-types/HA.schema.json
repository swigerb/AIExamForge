{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/HA.schema.json",
  "title": "HA",
  "type": "object",
  "additionalProperties": false,
  "required": ["imageAltText", "hotAreas", "minSelectionsRequired", "correctAreaIds"],
  "properties": {
    "imageAltText": { "type": "string", "minLength": 10 },
    "hotAreas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "minSelectionsRequired": { "type": "integer", "minimum": 2 },
    "correctAreaIds": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
