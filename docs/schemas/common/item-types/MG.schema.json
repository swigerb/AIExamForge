{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/MG.schema.json",
  "title": "MG",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "targets", "correctMatches"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "correctMatches": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetIndex", "sourceIndex"],
        "properties": {
          "targetIndex": { "type": "integer", "minimum": 0 },
          "sourceIndex": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
