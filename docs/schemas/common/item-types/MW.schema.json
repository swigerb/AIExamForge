{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiexamforge/schemas/item-types/MW.schema.json",
  "title": "MW",
  "type": "object",
  "additionalProperties": false,
  "required": ["codeBlocks", "requiredStepCount", "validOrders"],
  "properties": {
    "codeBlocks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredStepCount": { "type": "integer", "minimum": 3, "maximum": 5 },
    "validOrders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "items": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    }
  }
}
